[Unit]
Description=Apex Corp CTF Stage 2 Web Application
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ctf-v2/stage2_web/app
ExecStart=/usr/bin/python3 /home/ubuntu/ctf-v2/stage2_web/app/server.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
