# ========================================================
# CYBEREDU PLATFORMASI NAMUNAVIY MUHIT O'ZGARUVCHILARI
# ========================================================

# PostgreSQL Ulanish Manzili (Kamida mustahkam parol bilan)
DATABASE_URL="postgresql://username:password@localhost:5432/cyberedu?schema=public"

# Sessiyalarni shifrlash va imzolash uchun kuchli kalit (kamida 32 belgi)
SESSION_SECRET="your-32-character-session-secret-key-here-must-be-unique"

# Dinamik flag'larni (HMAC) yaratish uchun sirli kalit (kamida 32 belgi)
FLAG_SECRET="your-32-character-flag-hmac-secret-key-here-must-be-unique"

# Sandbox Sidecar Daemon bilan xavfsiz aloqa kaliti (kamida 32 belgi)
DAEMON_SECRET="your-32-character-daemon-internal-secret-key-here-unique"

# Birlamchi Administrator (Seed skripti orqali yaratiladi)
ADMIN_INIT_EMAIL="admin@cyberedu.uz"
ADMIN_INIT_PASSWORD="ChangeMe#2026!Strong"
ADMIN_INIT_NAME="Bosh Ustoz"
ADMIN_INIT_PHONE="+998901234567"

# Sandbox va laboratoriya limitlari (Contabo Cloud VPS: 6 vCPU, 12 GB RAM)
MAX_TERMINALS="15"
MAX_WEB_LABS="4"

# Video darsliklar saqlash sozlamalari
VIDEO_DIR="data/videos"
MAX_VIDEO_SIZE_BYTES="1610612736"

# Uy vazifalari birikmalari saqlash sozlamalari (10-Bosqich)
ATTACHMENTS_DIR="data/attachments"
MAX_ATTACHMENT_SIZE_BYTES="10485760"

# Telegram Bot bildirishnomalari (10-Bosqich)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_BOT_USERNAME="CyberEduUzBot"
TELEGRAM_WEBHOOK_SECRET="telegram-webhook-secret-key-32chars"

# Ikki bosqichli autentifikatsiya (2FA TOTP) va Eslatmalar (11-Bosqich)
TOTP_ENCRYPTION_KEY="your-32-character-totp-encryption-key-aes-256-gcm"
CRON_SECRET="your-32-character-cron-scheduler-secret-key-unique"
ADMIN_RESET_TOKEN="your-32-character-admin-reset-emergency-token"
