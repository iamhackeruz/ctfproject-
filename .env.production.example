# ==============================================================================
# CyberEdu Platform — Production Muhit O'zgaruvchilari (.env.production.example)
#
# DIQQAT: Ushbu fayldan namuna sifatida foydalaning va ishlab chiqarish serverida
# '.env' nomiga nusxalang. Hech qachon ushbu faylga real sirlarni yozmang va git ga yuklamang!
#
# Barcha maxfiy kalitlarni (secret) quyidagi buyruq orqali mustaqil yarating:
#   openssl rand -hex 32
# ==============================================================================

# ── 1. ASOSIY TIZIM PARAMETRLARI (Majburiy) ──────────────────────────────────
NODE_ENV=production
PORT=3000
DOMAIN=cyberedu.uz
LABS_DOMAIN=labs.cyberedu.uz
ACME_EMAIL=admin@cyberedu.uz
APP_URL=https://cyberedu.uz
LABS_ORIGIN=https://labs.cyberedu.uz

# ── 2. MA'LUMOTLAR BAZASI (PostgreSQL 16) (Majburiy) ─────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
# Docker compose ichida host nomi 'postgres', port esa 5432 bo'ladi.
POSTGRES_USER=cyberedu_admin
POSTGRES_PASSWORD=Haqiqiy_Juda_Murakkab_Parol_Openssl_Orqali
POSTGRES_DB=cyberedu_production
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# ── 3. KRIPTOGRAFIK MAXFIY KALITLAR (Majburiy, Har biri mustaqil bo'lishi shart)
# Generatsiya qilish buyrug'i: openssl rand -hex 32
# Talab: Kamida 32 bayt (64 belgi), takrorlanmas kriptografik entropiya

# Sessiya cookie'larini imzolash va shifrlash kaliti
SESSION_SECRET=GENERATSIYA_QILINGAN_64_BELGILI_HEX_SESSION_SECRET

# Dinamik HMAC flag'larni yaratish va solishtirish kaliti (konteynerga tushmaydi!)
FLAG_SECRET=GENERATSIYA_QILINGAN_64_BELGILI_HEX_FLAG_SECRET

# Qisqa muddatli bir martalik lab ticket'larini imzolash kaliti
TICKET_SECRET=GENERATSIYA_QILINGAN_64_BELGILI_HEX_TICKET_SECRET

# Next.js ilovasi va Sandbox Sidecar o'rtasidagi so'rovlarni HMAC imzolash kaliti
SIDECAR_SECRET=GENERATSIYA_QILINGAN_64_BELGILI_HEX_SIDECAR_SECRET
DAEMON_SECRET=GENERATSIYA_QILINGAN_64_BELGILI_HEX_DAEMON_SECRET

# ── 4. SANDBOX DAEMON SIDECAR ALOQASI (Majburiy) ─────────────────────────────
# Docker Compose ichida ichki tarmoq bo'yicha bog'lanish manzili
SANDBOX_DAEMON_URL=http://sandbox-daemon:5055

# ── 5. RO'YXATDAN O'TISH SIYOSATI (Majburiy) ─────────────────────────────────
# Ochiq ro'yxatdan o'tishni boshqarish:
# - 'false': Ochiq ro'yxatdan o'tish yopiq (faqat o'quv markaz ustozining taklif kodi orqali)
# - 'true': Har kim mustaqil ro'yxatdan o'tishi mumkin
ALLOW_PUBLIC_REGISTRATION=false

# ── 6. BIRINCHI ISHGA TUSHIRISHDA ADMIN YARATISH (Ixtiyoriy/Bir martalik) ────
# 'npm run init:admin' skripti tomonidan birinchi marta tizimga asosiy administratorni
# xavfsiz qo'shish uchun ishlatiladi (faqat bir marta, agar bazada admin bo'lmasa ishlaydi).
ADMIN_INIT_EMAIL=admin@cyberedu.uz
ADMIN_INIT_PASSWORD=Murakkab_Admin_Parol_Kamida_12_Belgi!
ADMIN_INIT_NAME="Kiberxavfsizlik Bosh Administratori"

# ── 7. EMAIL XIZMATI (SMTP) (Ixtiyoriy, Parol tiklash uchun) ────────────────
# Agar ushbu parametrlar kiritilmasa, email yuborilmaydi. Buning o'rniga ustoz yoki
# admin talaba uchun bevosita panel orqali bir martalik vaqtinchalik parol berishi mumkin.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@cyberedu.uz
SMTP_PASS=SuperSecureSmtpPassword
SMTP_FROM="CyberEdu Kiberxavfsizlik Ta'limi <noreply@cyberedu.uz>"
SMTP_SECURE=false

# ── 8. SANDBOX VA KONTEYNER CHEKLOVLARI (Contabo Cloud VPS: 6 vCPU, 12 GB RAM) ───
# Bir vaqtdagi faol terminal sandboxlari soni
MAX_TERMINALS=15

# Bir vaqtdagi faol veb-laboratoriya instansiyalari soni
MAX_WEB_LABS=4

# ── 9. VIDEO DARSLIKLAR SAQLASH SOZLAMALARI ─────────────────────────────────
# Serverdagi yopiq video katalogi (Docker konteyner ichida /app/data/videos)
VIDEO_DIR=/app/data/videos
MAX_VIDEO_SIZE_BYTES=1610612736 # 1.5 GB limit

# ── 10. UY VAZIFALARI BIRIKMALARI SAQLASH SOZLAMALARI (10-Bosqich) ───────────
# Serverdagi yopiq birikmalar katalogi (Docker konteyner ichida /app/data/attachments)
ATTACHMENTS_DIR=/app/data/attachments
MAX_ATTACHMENT_SIZE_BYTES=10485760 # 10 MB limit

# ── 11. TELEGRAM BOT BILDIRISHNOMALARI (10-Bosqich) ─────────────────────────
# Telegram @BotFather orqali yaratilgan bot tokeni
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Bot username (masalan: CyberEduUzBot)
TELEGRAM_BOT_USERNAME=CyberEduUzBot
# Webhook xavfsizlik siri (X-Telegram-Bot-Api-Secret-Token uchun: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=TELEGRAM_UCHUN_HEX_MAXFIY_KALIT_KAMIDA_32_BELGI
# Zaxira hisobotlari yuboriladigan Telegram kanal/guruh ID
TELEGRAM_BACKUP_CHANNEL_ID=@cyberedu_backup_channel

# ── 12. IKKI BOSQICHLI AUTENTIFIKATSIYA (2FA TOTP) VA CRON (11-Bosqich) ─────
# TOTP sirlarini AES-256-GCM bilan shifrlash kaliti (openssl rand -hex 32)
TOTP_ENCRYPTION_KEY=GENERATSIYA_QILINGAN_64_BELGILI_HEX_TOTP_KEY
# Cron scheduler endpointini himoyalash kaliti (openssl rand -hex 32)
CRON_SECRET=GENERATSIYA_QILINGAN_64_BELGILI_HEX_CRON_SECRET
# Favqulodda admin 2FA ni tiklash siri (openssl rand -hex 32)
ADMIN_RESET_TOKEN=GENERATSIYA_QILINGAN_64_BELGILI_HEX_ADMIN_RESET_TOKEN
