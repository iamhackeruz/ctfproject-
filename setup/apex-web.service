[Unit]
Description=Apex Corp CTF Stage 2 Web Application
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/apex-ctf/stage2_web/app
ExecStart=/usr/bin/python3 /opt/apex-ctf/stage2_web/app/server.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
